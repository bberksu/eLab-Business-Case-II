```{r}
library(tidyverse)
library(dplyr)
library(tidyr)
library(stringr)
library(tibble)
library (ggplot2)
```

Raw data:

```{r}
lines <- readLines("/Users/beliz/Desktop/business_analytics/year2/Supermarket-eLab2/supermarket.csv", warn = FALSE)

supermarket_raw <- tibble(
  transaction_id = 1:length(lines),
  basket = lines
)

head(supermarket_raw)
```

Parse:

```{r}
long_data <- supermarket_raw %>%
  separate_rows(basket, sep = ",") %>%
  mutate(basket = str_trim(basket)) %>%
  separate(
    basket,
    into = c("department", "time", "price"),
    sep = "\\s+"
  ) %>%
  mutate(
    department = as.integer(department),
    time = as.numeric(time),
    price = as.numeric(price)
  )

head(long_data)
str(long_data)
summary(long_data)
length(unique(long_data$transaction_id))
```

Mapping:

```{r}
dept_map <- c(
  "1" = "Bakery & Pastry",
  "2" = "Beer & Wine",
  "3" = "Books & Magazines",
  "4" = "Candy & Chips",
  "5" = "Care & Hygiene",
  "6" = "Cereals & Spreads",
  "7" = "Cheese & Tapas",
  "8" = "Dairy & Eggs",
  "9" = "Freezer",
  "10" = "Fruit & Vegetables",
  "11" = "Household & Pet",
  "12" = "Meat & Fish",
  "13" = "Pasta & Rice",
  "14" = "Salads & Meals",
  "15" = "Sauces & Spices",
  "16" = "Soda & Juices",
  "17" = "Special Diet",
  "18" = "Vegetarian & Vegan"
)

long_data <- long_data %>%
  mutate(department_name = dept_map[as.character(department)])

head(long_data)
```

Cleaning:

```{r}
long_data_clean <- long_data %>%
  filter(
    !is.na(department),
    !is.na(time),
    !is.na(price)
  ) %>%
  mutate(
    price_per_second = ifelse(time > 0, price / time, NA_real_)
  )
```

Summary:

```{r}
basket_data <- long_data_clean %>%
  group_by(transaction_id) %>%
  summarise(
    total_items = n(),
    total_price = sum(price, na.rm = TRUE),
    avg_price = mean(price, na.rm = TRUE),
    total_time = sum(time, na.rm = TRUE),
    avg_time_per_item = total_time / total_items,
    price_per_second = ifelse(total_time > 0, total_price / total_time, NA_real_),
    max_price = max(price),
    min_price = min(price),
    unique_departments = n_distinct(department),
    .groups = "drop"
  )

head(basket_data)
str(basket_data)
summary(basket_data)
```

#Time for basket analysis:

```{r}
#visuals for total price and total items
ggplot(basket_data, aes(x = total_items)) +
  geom_histogram(binwidth = 1, fill = "steelblue", color = "white") +
