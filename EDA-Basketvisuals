ggplot(basket_data, aes(x = total_price)) +
  geom_histogram(binwidth = 2, fill = "coral", color = "white") +
  labs(title = "Distribution of Total Basket Value", x = "Total Price (€)", y = "Count")

ggplot(basket_data, aes(x = total_items, y = total_price)) +
  geom_point(alpha = 0.3) +
  geom_smooth(method = "lm") +
  labs(title = "Basket Size vs. Total Spend")


boxplot(basket_data$total_items, main = "Basket Size", ylab = "Items")
boxplot(basket_data$total_price, main = "Total Basket Value", ylab = "Price (€)")
```

```{r}
basket_time_filtered <- basket_data %>%
  filter(total_time < quantile(total_time, 0.99))

ggplot(basket_time_filtered, aes(x = total_time)) +
  geom_histogram(aes(y = ..density..),
    bins = 50,
    fill = "lightblue",
    color = "white",
    alpha = 0.7
  ) + geom_density(color = "black", linewidth = 1) +
  geom_vline(
    aes(xintercept = median(total_time)),
    linetype = "dashed",
    linewidth = 1
  ) +
  labs(
    title = "Distribution of total scan time",
    subtitle = "Top 1% of extreme transactions removed; dashed line shows median",
    x = "Total scan time (seconds)",
    y = "Number of transactions"
  ) +
  theme_minimal(base_size = 13) +
  theme(
    plot.title = element_text(face = "bold"),
    axis.title = element_text(face = "bold"),
    panel.grid.minor = element_blank()
  )

ggplot(basket_time_filtered, aes(x = total_time)) +
  geom_histogram(bins = 50, fill = "blue") +
  scale_x_log10() +
  labs(
    title = "Distribution of total scan time (log scale)",
    x = "log(total time)",
    y = "count"
  ) +
  theme_minimal()
```

